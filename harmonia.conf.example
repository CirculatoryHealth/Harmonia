#!/usr/bin/env bash
#
# harmonia.conf.example — site-specific configuration template
#
# ── One-time setup ────────────────────────────────────────────────────────────
# 1. Copy this file:   cp harmonia.conf.example harmonia.conf
# 2. Edit harmonia.conf and fill in the four paths + your email below.
# 3. Done — all gwas2cojo scripts will pick up the settings automatically.
#
# harmonia.conf is listed in .gitignore so your local settings are never
# accidentally committed to the public repository.
# ─────────────────────────────────────────────────────────────────────────────

# Absolute path to harmonia.py
# (the directory where you cloned / installed Harmonia)
PYTHON_SCRIPT="/path/to/harmonia/harmonia.py"

# Directory containing gwaslab reference files
# (1KG VCFs, FASTA, dbSNP VCFs, recombination maps, …)
# Use harmonia.download_refs.py to populate this directory.
REF_DIR="/path/to/references/gwaslab"

# Base output directory — per-study subdirectories and SLURM logs go here
OUT_BASE="/path/to/output/harmonia"

# Conda environment name (created from environment.yml)
CONDA_ENV="harmonia"

# Email address for SLURM job failure notifications
EMAIL="your@email.com"
